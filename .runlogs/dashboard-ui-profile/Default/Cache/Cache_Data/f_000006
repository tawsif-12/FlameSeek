ight drawer                     */\r\n/* Globe shifts aside when a drawer is open; centered when closed.      */\r\n/* ================================================================== */\r\n\r\n.command-globe .cesium-container {\r\n  transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);\r\n  transform-origin: 40% 50%;\r\n  will-change: transform;\r\n}\r\n.command-globe.insight-open .cesium-container {\r\n  transform: translateX(-9%) scale(0.82);\r\n}\r\n\r\n.insight-dock {\r\n  position: absolute;\r\n  left: 50%;\r\n  bottom: 96px;\r\n  transform: translateX(-50%);\r\n  z-index: 6;\r\n  display: flex;\r\n  gap: 4px;\r\n  padding: 5px;\r\n  border-radius: 999px;\r\n  background: var(--sp-hud-bg);\r\n  border: 1px solid var(--sp-border);\r\n  box-shadow: 0 16px 40px -24px rgba(0, 0, 0, 0.7);\r\n  backdrop-filter: blur(14px);\r\n}\r\n.insight-dock button {\r\n  padding: 9px 18px;\r\n  border-radius: 999px;\r\n  background: transparent;\r\n  border: 0;\r\n  color: var(--sp-text-dim);\r\n  font-family: var(--mission-font);\r\n  font-size: 10.5px;\r\n  letter-spacing: 0.14em;\r\n  text-transform: uppercase;\r\n  font-weight: 800;\r\n  cursor: pointer;\r\n  transition: color 160ms ease, background 160ms ease;\r\n}\r\n.insight-dock button:hover { color: var(--sp-text); }\r\n.insight-dock button.active {\r\n  color: #06111f;\r\n  background: var(--sp-cyan);\r\n  box-shadow: 0 0 18px -6px var(--sp-cyan-glow);\r\n}\r\n\r\n.insight-drawer {\r\n  position: absolute;\r\n  top: 20px;\r\n  bottom: 88px;\r\n  right: calc(var(--globe-right-panel-width) + 36px);\r\n  width: min(360px, 26vw);\r\n  z-index: 5;\r\n  display: flex;\r\n  flex-direction: column;\r\n  padding: 18px 18px 16px;\r\n  border-radius: 18px;\r\n  background: var(--sp-hud-bg);\r\n  border: 1px solid var(--sp-border);\r\n  color: var(--sp-text);\r\n  box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.7);\r\n  backdrop-filter: blur(14px);\r\n  animation: insight-slide-in 320ms cubic-bezier(0.16, 1, 0.3, 1) both;\r\n}\r\n.insight-drawer::before {\r\n  content: \"\";\r\n  position: absolute; inset: 0;\r\n  border-radius: inherit; padding: 1px;\r\n  background: linear-gradient(140deg, rgba(106, 215, 255, 0.34), transparent 50%, rgba(255, 138, 91, 0.20) 100%);\r\n  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\r\n  -webkit-mask-composite: xor; mask-composite: exclude;\r\n  pointer-events: none;\r\n  opacity: 0.7;\r\n}\r\n@keyframes insight-slide-in {\r\n  from { opacity: 0; transform: translateX(24px); }\r\n  to { opacity: 1; transform: translateX(0); }\r\n}\r\n\r\n.insight-drawer > header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n  margin-bottom: 14px;\r\n  flex-shrink: 0;\r\n}\r\n.insight-drawer .insight-body {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding-right: 2px;\r\n}\r\n.insight-drawer .insight-body::-webkit-scrollbar { width: 6px; }\r\n.insight-drawer .insight-body::-webkit-scrollbar-thumb { background: var(--sp-border-strong); border-radius: 999px; }\r\n.insight-drawer .mission-kicker {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  color: var(--sp-cyan);\r\n  font-family: var(--mission-font);\r\n  font-size: 11px;\r\n  letter-spacing: 0.16em;\r\n  text-transform: uppercase;\r\n}\r\n.insight-drawer .insight-context {\r\n  display: block;\r\n  margin-top: 3px;\r\n  color: var(--sp-text-dim);\r\n  font-size: 11px;\r\n}\r\n.insight-close {\r\n  width: 30px; height: 30px;\r\n  display: grid; place-items: center;\r\n  border-radius: 50%;\r\n  color: var(--sp-text-dim);\r\n  background: rgba(255, 255, 255, 0.04);\r\n  border: 1px solid var(--sp-border);\r\n  font-size: 16px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n}\r\n.insight-close:hover { color: var(--sp-text); border-color: var(--sp-border-strong); }\r\n.insight-body { display: grid; gap: 12px; }\r\n.snapshot-body { grid-template-columns: 1fr; }\r\n.insight-note {\r\n  margin: 6px 0 