rsor: pointer;\r\n}\r\n\r\n/* Home: story, separation, workflow */\r\n.story-section,\r\n.separation-section,\r\n.workflow-section {\r\n  padding: 36px clamp(22px, 4vw, 64px);\r\n  color: #e5e7eb;\r\n  background: #020915;\r\n}\r\n\r\n.story-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));\r\n  gap: 12px;\r\n  margin-top: 14px;\r\n}\r\n\r\n.story-card {\r\n  display: grid;\r\n  align-content: start;\r\n  gap: 6px;\r\n  padding: 16px;\r\n  color: inherit;\r\n  text-decoration: none;\r\n  background: rgba(15, 23, 42, 0.8);\r\n  border: 1px solid rgba(148, 163, 184, 0.2);\r\n  border-radius: 8px;\r\n  transition: border-color 0.2s ease;\r\n}\r\n\r\n.story-card:hover {\r\n  border-color: #f97316;\r\n}\r\n\r\n.story-card span {\r\n  color: #f97316;\r\n  font-family: var(--mission-font);\r\n  font-weight: 900;\r\n}\r\n\r\n.story-card em {\r\n  color: #f8fafc;\r\n  font-style: normal;\r\n}\r\n\r\n.story-card small {\r\n  color: #94a3b8;\r\n}\r\n\r\n.separation-section {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\r\n  gap: 12px;\r\n  padding-top: 0;\r\n}\r\n\r\n.sep {\r\n  padding: 14px 16px;\r\n  background: rgba(15, 23, 42, 0.8);\r\n  border-top: 3px solid;\r\n  border-radius: 6px;\r\n}\r\n\r\n.sep h3 {\r\n  margin: 0 0 6px;\r\n}\r\n\r\n.sep p {\r\n  margin: 0;\r\n  color: #cbd5e1;\r\n  font-size: 14px;\r\n}\r\n\r\n.sep.obs { border-top-color: var(--tone-obs); }\r\n.sep.inf { border-top-color: var(--tone-inf); }\r\n.sep.ext { border-top-color: var(--tone-ext); }\r\n.sep.fc { border-top-color: var(--tone-fc); }\r\n\r\n.workflow-chain {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  margin: 14px 0 0;\r\n  padding: 0;\r\n  list-style: none;\r\n  counter-reset: step;\r\n}\r\n\r\n.workflow-chain li {\r\n  padding: 5px 10px;\r\n  color: #cbd5e1;\r\n  background: rgba(30, 41, 59, 0.8);\r\n  border-radius: 999px;\r\n  font-size: 12px;\r\n  counter-increment: step;\r\n}\r\n\r\n.workflow-chain li::before {\r\n  content: counter(step) \" \";\r\n  color: #f97316;\r\n  font-weight: 800;\r\n}\r\n\r\n/* Sources & Methods */\r\n.source-group h3 {\r\n  margin: 18px 0 10px;\r\n}\r\n\r\n.access-pill {\r\n  display: inline-block !important;\r\n  width: fit-content;\r\n  padding: 2px 8px;\r\n  border-radius: 999px;\r\n}\r\n\r\n.access-pill.automated { color: #166534 !important; background: #dcfce7; }\r\n.access-pill.review-link { color: #1e40af !important; background: #dbeafe; }\r\n.access-pill.optional { color: #92400e !important; background: #fef3c7; }\r\n\r\n.methods {\r\n  margin: 24px 0;\r\n}\r\n\r\n.methods-list > div {\r\n  grid-template-columns: minmax(140px, 180px) 1fr;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .memory-setup,\r\n  .memory-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .event-panel {\r\n    right: 12px;\r\n    left: 12px;\r\n    width: auto;\r\n  }\r\n\r\n  .globe-left {\r\n    display: none;\r\n  }\r\n}\r\n\r\n\r\n/* ============ NASA-inspired space theme (Home + Fire Memory + Sources & Methods) ============ */\r\n\r\n.space-shell {\r\n  --sp-bg: #05080f;\r\n  --sp-bg-2: #0a1220;\r\n  --sp-cyan: #6ad7ff;\r\n  --sp-cyan-soft: rgba(106, 215, 255, 0.28);\r\n  --sp-cyan-glow: rgba(106, 215, 255, 0.55);\r\n  --sp-border: rgba(148, 197, 255, 0.16);\r\n  --sp-border-strong: rgba(148, 197, 255, 0.34);\r\n  --sp-text: #e6f1ff;\r\n  --sp-text-dim: rgba(198, 220, 246, 0.72);\r\n  --sp-warn: #ffb066;\r\n  --sp-good: #74e1c0;\r\n  color: var(--sp-text);\r\n  background: radial-gradient(1200px 700px at 15% -10%, rgba(70, 140, 220, 0.22), transparent 60%),\r\n              radial-gradient(900px 700px at 100% 20%, rgba(126, 90, 255, 0.16), transparent 60%),\r\n              linear-gradient(180deg, #05080f 0%, #030509 100%);\r\n}\r\n\r\n.brand-mark {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n}\r\n.brand-glyph {\r\n  color: var(--sp-cyan, #6ad7ff);\r\n  display: grid;\r\n  place-items: center;\r\n  width: 42px;\r\n  height: 42px;\r\n  border-radius: 999px;\r\n  border: 1px solid rgba(148, 197, 255, 0.28);\r\n  background: radial-gradient(circle at 40% 30%, rgba(106, 215, 255, 0.35), transparent 60%);\r\n  box-shadow: 0 0 22px rgba(106, 215, 255, 0.25);\r\n}\r\n.mission-header .brand-glyph { color: #cfeeff; }\r\n.app-header:not(.mission-header) .brand-glyph { color: #0f4b7a; border-color: rgba(15, 75, 122, 0.2); box-shadow: none; background: rgba(15, 75, 122, 0.08); }\r\n\r\n/* -------- HERO on Home -------- */\r\n\r\n.nasa-hero {\r\n  grid-template-columns: minmax(0, 1fr);\r\n  padding: clamp(110px, 14vh, 160px) clamp(28px, 6vw, 96px) clamp(80px, 10vh, 140px);\r\n}\r\n.hero-inner {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1.35fr) minmax(320px, 420px);\r\n  gap: clamp(24px, 3vw, 64px);\r\n  align-items: start;\r\n  width: 100%;\r\n}\r\n.hero-main .mission-kicker {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 6px 12px;\r\n  border-radius: 999px;\r\n  background: rgba(106, 215, 255, 0.08);\r\n  border: 1px solid var(--sp-cyan-soft);\r\n  color: #a8e2ff;\r\n}\r\n.hero-main .mission-kicker .dot {\r\n  width: 6px; height: 6px; border-radius: 50%; background: var(--sp-cyan);\r\n  box-shadow: 0 0 10px var(--sp-cyan-glow);\r\n}\r\n.hero-main h2 {\r\n  font-family: var(--mission-font);\r\n  font-size: clamp(58px, 8vw, 108px);\r\n  line-height: 0.9;\r\n  margin: 14px 0 18px;\r\n  background: linear-gradient(180deg, #eaf7ff 0%, #86c8ff 100%);\r\n  -webkit-background-clip: text;\r\n  background-clip: text;\r\n  color: transparent;\r\n  text-shadow: 0 0 60px rgba(106, 175, 255, 0.25);\r\n}\r\n.hero-main .mission-statement { color: var(--sp-text-dim); }\r\n\r\n.hero-orbit-rings {\r\n  position: absolute;\r\n  left: -20vw;\r\n  top: -20vh;\r\n  width: 130vh;\r\n  height: 130vh;\r\n  pointer-events: none;\r\n  opacity: 0.6;\r\n}\r\n.hero-orbit-rings span {\r\n  position: absolute;\r\n  inset: 0;\r\n  border: 1px solid rgba(150, 210, 255, 0.08);\r\n  border-radius: 50%;\r\n}\r\n.hero-orbit-rings span:nth-child(2) { inset: 8%; border-color: rgba(150, 210, 255, 0.12); }\r\n.hero-orbit-rings span:nth-child(3) { inset: 16%; border-color: rgba(150, 210, 255, 0.06); }\r\n\r\n.explore-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 18px;\r\n  margin-top: 34px;\r\n  flex-wrap: wrap;\r\n}\r\n.explore-orb,\r\n.ghost-orb {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: 200px;\r\n  height: 68px;\r\n  padding: 0 26px;\r\n  border-radius: 999px;\r\n  font-family: var(--mission-font);\r\n  font-size: 12px;\r\n  font-weight: 800;\r\n  letter-spacing: 0.28em;\r\n  text-decoration: none;\r\n  color: #dff3ff;\r\n  border: 1px solid var(--sp-border-strong);\r\n  background:\r\n    radial-gradient(120% 220% at 50% 130%, rgba(106, 215, 255, 0.45) 0%, transparent 55%),\r\n    linear-gradient(180deg, rgba(15, 30, 55, 0.7), rgba(6, 12, 24, 0.7));\r\n  box-shadow: 0 12px 60px -20px rgba(106, 215, 255, 0.6),\r\n              inset 0 0 0 1px rgba(255, 255, 255, 0.04);\r\n  transition: transform 200ms ease, box-shadow 200ms ease;\r\n}\r\n.explore-orb:hover,\r\n.ghost-orb:hover { transform: translateY(-1px); box-shadow: 0 18px 80px -18px rgba(106, 215, 255, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.05); }\r\n.ghost-orb {\r\n  background: rgba(6, 12, 24, 0.55);\r\n  color: #cfe6ff;\r\n  box-shadow: none;\r\n}\r\n\r\n.ask-strip {\r\n  margin-top: 20px;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 12px 18px 12px 14px;\r\n  max-width: 620px;\r\n  border-radius: 999px;\r\n  border: 1px solid var(--sp-border);\r\n  background: rgba(6, 12, 24, 0.55);\r\n  color: var(--sp-text-dim);\r\n  font-size: 13px;\r\n  backdrop-filter: blur(10px);\r\n}\r\n.ask-spark {\r\n  display: grid; place-items: center;\r\n  width: 30px; height: 30px; border-radius: 999px;\r\n  background: rgba(106, 215, 255, 0.12);\r\n  color: var(--sp-cyan);\r\n}\r\n.ask-actions { margin-left: auto; display: flex; gap: 8px; color: rgba(198, 220, 246, 0.55); font-style: italic; }\r\n.ask-actions i { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--sp-border); font-style: normal; font-size: 11px; }\r\n\r\n/* -------- Glass cards -------- */\r\n.glass-card {\r\n  position: relative;\r\n  border-radius: 22px;\r\n  border: 1px solid var(--sp-border);\r\n  background: linear-gradient(180deg, rgba(20, 34, 60, 0.62), rgba(6, 12, 24, 0.58));\r\n  box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.6),\r\n              inset 0 0 0 1px rgba(255, 255, 255, 0.02);\r\n  backdrop-filter: blur(14px);\r\n}\r\n.glass-card::before {\r\n  content: \"\";\r\n  position: absolute; inset: 0;\r\n  border-radius: inherit;\r\n  padding: 1px;\r\n  background: linear-gradient(140deg, rgba(106, 215, 255, 0.35), transparent 40%, rgba(126, 90, 255, 0.25) 100%);\r\n  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\r\n  -webkit-mask-composite: xor;\r\n          mask-composite: exclude;\r\n  pointer-events: none;\r\n  opacity: 0.55;\r\n}\r\n\r\n.hero-panels {\r\n  display: grid;\r\n  gap: 20px;\r\n}\r\n\r\n.code-card {\r\n  padding: 22px 22px 18px;\r\n  display: grid;\r\n  gap: 18px;\r\n}\r\n.code-card header {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n.code-card h3 {\r\n  margin: 0;\r\n  font-family: var(--mission-font);\r\n  color: var(--sp-text-dim);\r\n  font-size: 13px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.2em;\r\n  text-transform: uppercase;\r\n  line-height: 1.4;\r\n}\r\n.code-card h3 strong {\r\n  display: block;\r\n  color: var(--sp-text);\r\n  font-size: 22px;\r\n  letter-spacing: 0.14em;\r\n  margin-top: 4px;\r\n}\r\n.glass-close {\r\n  display: grid; place-items: center;\r\n  width: 30px; height: 30px; border-radius: 50%;\r\n  color: var(--sp-text-dim);\r\n  background: rgba(255, 255, 255, 0.04);